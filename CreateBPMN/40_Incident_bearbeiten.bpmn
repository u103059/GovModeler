<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:adonis="http://www.boc-group.com" id="definition__incbea_01" targetNamespace="http://www.boc-group.com" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:collaboration id="Collaboration_incbea_01" name="Incident bearbeiten" isClosed="false">
    <bpmn:participant id="_kunde_participant_incbea" name="Kunde" processRef="process_kunde_incbea" />
    <bpmn:participant id="_org_participant_incbea" name="Organisation" processRef="process_org_incbea" />
    <bpmn:messageFlow id="_msgflow_k_o_meldung_incbea" name="Incident-Meldung mit Fehlerbeschreibung, betroffenem System und Kontaktdaten" sourceRef="_kunde_task1_incbea" targetRef="_org_start_incbea">
      <bpmn:extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
        </adonis:connector>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="_msgflow_o_k_loesung_incbea" name="Loesungsmitteilung mit Hinweis zur Stoerungsbehebung und zum Ticketabschluss" sourceRef="_org_task8_incbea" targetRef="_kunde_catch1_incbea">
      <bpmn:extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0">
            <adonis:value>true</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0">
            <adonis:value>automatisch</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
        </adonis:connector>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="process_kunde_incbea" name="Kunde" processType="None" isClosed="false" isExecutable="false">
    <bpmn:laneSet id="laneSet_kunde_incbea">
      <bpmn:lane id="_kunde_lane_incbea" name="Meldende Stelle">
        <bpmn:flowNodeRef>_kunde_start_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_kunde_task1_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_kunde_catch1_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_kunde_task2_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_kunde_end_incbea</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="_kunde_start_incbea" name="Stoerung festgestellt">
      <bpmn:outgoing>_kunde_flow1_incbea</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="_kunde_task1_incbea" name="Incident melden">
      <bpmn:documentation textFormat="text/plain">Die meldende Stelle teilt dem Servicedesk die festgestellte IT-Stoerung mit. Die Meldung enthaelt eine Fehlerbeschreibung, das betroffene System und die Kontaktdaten. Ergebnis ist die Incident-Meldung als Ausloeser der Bearbeitung.</bpmn:documentation>
      <bpmn:incoming>_kunde_flow1_incbea</bpmn:incoming>
      <bpmn:outgoing>_kunde_flow2_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="_kunde_catch1_incbea" name="Loesungsmitteilung erhalten">
      <bpmn:incoming>_kunde_flow2_incbea</bpmn:incoming>
      <bpmn:outgoing>_kunde_flow3_incbea</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgEvtDef_kunde_catch1_incbea" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="_kunde_task2_incbea" name="Stoerungsbehebung pruefen">
      <bpmn:documentation textFormat="text/plain">Die meldende Stelle prueft anhand der Loesungsmitteilung, ob die gestoerte IT-Leistung wieder uneingeschraenkt zur Verfuegung steht. Ergebnis ist die Bestaetigung der Stoerungsbehebung.</bpmn:documentation>
      <bpmn:incoming>_kunde_flow3_incbea</bpmn:incoming>
      <bpmn:outgoing>_kunde_flow4_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="_kunde_end_incbea" name="Stoerungsbehebung erhalten">
      <bpmn:incoming>_kunde_flow4_incbea</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="_kunde_flow1_incbea" sourceRef="_kunde_start_incbea" targetRef="_kunde_task1_incbea" />
    <bpmn:sequenceFlow id="_kunde_flow2_incbea" sourceRef="_kunde_task1_incbea" targetRef="_kunde_catch1_incbea" />
    <bpmn:sequenceFlow id="_kunde_flow3_incbea" sourceRef="_kunde_catch1_incbea" targetRef="_kunde_task2_incbea" />
    <bpmn:sequenceFlow id="_kunde_flow4_incbea" sourceRef="_kunde_task2_incbea" targetRef="_kunde_end_incbea" />
  </bpmn:process>
  <bpmn:process id="process_org_incbea" name="Organisation" processType="None" isClosed="false" isExecutable="false">
    <bpmn:laneSet id="laneSet_org_incbea">
      <bpmn:lane id="_org_lane_servicedesk_incbea" name="Servicedesk">
        <bpmn:flowNodeRef>_org_start_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task1_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task2_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task3_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_event2_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task7_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task8_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_end_incbea</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_org_lane_fachbetreuung_incbea" name="IT-Fachbetreuung">
        <bpmn:flowNodeRef>_org_event1_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task4_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task5_incbea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_org_task6_incbea</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="_org_start_incbea" name="Incident-Meldung eingegangen">
      <bpmn:outgoing>_org_flow1_incbea</bpmn:outgoing>
      <bpmn:messageEventDefinition id="msgEvtDef_org_start_incbea" />
    </bpmn:startEvent>
    <bpmn:task id="_org_task1_incbea" name="Incident erfassen">
      <bpmn:documentation textFormat="text/plain">Der Servicedesk nimmt die Incident-Meldung entgegen und legt im Ticketsystem ein Ticket an. Fehlerbeschreibung, betroffenes System und Kontaktdaten werden uebernommen. Ergebnis ist ein erfasstes Ticket mit eindeutiger Kennung.</bpmn:documentation>
      <bpmn:incoming>_org_flow1_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow2_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_org_task2_incbea" name="Incident kategorisieren und priorisieren">
      <bpmn:documentation textFormat="text/plain">Der Servicedesk ordnet den Incident einer Kategorie zu und legt die Prioritaet nach Auswirkung und Dringlichkeit fuer den Schul- und Verwaltungsbetrieb fest. Ergebnis ist ein kategorisiertes und priorisiertes Ticket.</bpmn:documentation>
      <bpmn:incoming>_org_flow2_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow3_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_org_task3_incbea" name="Incident an IT-Fachbetreuung uebergeben">
      <bpmn:documentation textFormat="text/plain">Der Servicedesk weist das Ticket mit allen erfassten Angaben der zustaendigen IT-Fachbetreuung zur weiteren Bearbeitung zu. Ergebnis ist ein zugewiesenes Ticket.</bpmn:documentation>
      <bpmn:incoming>_org_flow3_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow4_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="_org_event1_incbea" name="Incident zugewiesen">
      <bpmn:incoming>_org_flow4_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow5_incbea</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="_org_task4_incbea" name="Ursache analysieren">
      <bpmn:documentation textFormat="text/plain">Die IT-Fachbetreuung untersucht die gemeldete Stoerung am betroffenen System und ermittelt die Ursache. Ergebnis ist die festgestellte Stoerungsursache als Grundlage der Loesung.</bpmn:documentation>
      <bpmn:incoming>_org_flow5_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow6_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_org_task5_incbea" name="Loesung umsetzen">
      <bpmn:documentation textFormat="text/plain">Die IT-Fachbetreuung beseitigt die Stoerungsursache durch die geeignete Massnahme am betroffenen System. Ergebnis ist die umgesetzte Loesung.</bpmn:documentation>
      <bpmn:incoming>_org_flow6_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow7_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_org_task6_incbea" name="Loesung testen">
      <bpmn:documentation textFormat="text/plain">Die IT-Fachbetreuung prueft, ob das betroffene System wieder fehlerfrei funktioniert. Ergebnis ist die bestaetigte Wiederherstellung der IT-Leistung.</bpmn:documentation>
      <bpmn:incoming>_org_flow7_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow8_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="_org_event2_incbea" name="Loesung bereitgestellt">
      <bpmn:incoming>_org_flow8_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow9_incbea</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="_org_task7_incbea" name="Incident dokumentieren und abschliessen">
      <bpmn:documentation textFormat="text/plain">Der Servicedesk haelt Ursache, Loesung und Bearbeitungsverlauf im Ticket fest und setzt das Ticket auf den Status geloest. Ergebnis ist ein dokumentiertes, abgeschlossenes Ticket.</bpmn:documentation>
      <bpmn:incoming>_org_flow9_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow10_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="_org_task8_incbea" name="Kunde ueber Loesung informieren">
      <bpmn:documentation textFormat="text/plain">Der Servicedesk teilt der meldenden Stelle mit, dass die Stoerung behoben wurde, und weist auf den Ticketabschluss hin. Ergebnis ist die uebermittelte Loesungsmitteilung.</bpmn:documentation>
      <bpmn:incoming>_org_flow10_incbea</bpmn:incoming>
      <bpmn:outgoing>_org_flow11_incbea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="_org_end_incbea" name="Incident abgeschlossen">
      <bpmn:incoming>_org_flow11_incbea</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="_org_flow1_incbea" sourceRef="_org_start_incbea" targetRef="_org_task1_incbea" />
    <bpmn:sequenceFlow id="_org_flow2_incbea" sourceRef="_org_task1_incbea" targetRef="_org_task2_incbea" />
    <bpmn:sequenceFlow id="_org_flow3_incbea" sourceRef="_org_task2_incbea" targetRef="_org_task3_incbea" />
    <bpmn:sequenceFlow id="_org_flow4_incbea" sourceRef="_org_task3_incbea" targetRef="_org_event1_incbea" />
    <bpmn:sequenceFlow id="_org_flow5_incbea" sourceRef="_org_event1_incbea" targetRef="_org_task4_incbea" />
    <bpmn:sequenceFlow id="_org_flow6_incbea" sourceRef="_org_task4_incbea" targetRef="_org_task5_incbea" />
    <bpmn:sequenceFlow id="_org_flow7_incbea" sourceRef="_org_task5_incbea" targetRef="_org_task6_incbea" />
    <bpmn:sequenceFlow id="_org_flow8_incbea" sourceRef="_org_task6_incbea" targetRef="_org_event2_incbea" />
    <bpmn:sequenceFlow id="_org_flow9_incbea" sourceRef="_org_event2_incbea" targetRef="_org_task7_incbea" />
    <bpmn:sequenceFlow id="_org_flow10_incbea" sourceRef="_org_task7_incbea" targetRef="_org_task8_incbea" />
    <bpmn:sequenceFlow id="_org_flow11_incbea" sourceRef="_org_task8_incbea" targetRef="_org_end_incbea" />
  </bpmn:process>
