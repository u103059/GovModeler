<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:adonis="http://www.boc-group.com"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition__a6500000-1000-4000-8000-000000000001"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             targetNamespace="http://www.boc-group.com">
  <message id="_a6500000-1000-4000-8000-000000000002" name="Anmeldung mit Grundschulempfehlung und Nachweisen"/>
  <message id="_a6500000-1000-4000-8000-000000000003" name="Anmeldebestaetigung"/>
  <collaboration id="Collaboration_a6500000-1000-4000-8000-000000000004" name="Schule an weiterfuehrender Schule anmelden" isClosed="false">
    <documentation textFormat="text/plain">Kundenbeduerfnis: Die Sorgeberechtigten benoetigen fuer ihr Kind nach der Grundschule einen Platz an einer weiterfuehrenden Schule in Stuttgart. Kundenstart: Bedarf an Anmeldung an weiterfuehrender Schule festgestellt. Kundenende: Anmeldebestaetigung erhalten. Modelliert ist der Happy Path mit vollstaendigen Unterlagen und verfuegbarem Schulplatz. Beteiligte: Sorgeberechtigte (Kunde) sowie Schule und Schulverwaltungsamt (Organisation). Aktuelle Anmeldevorgaben, schulartspezifische Voraussetzungen und Zustaendigkeiten sind fachlich zu bestaetigen. Grundlage: BPMN_ADONIS/BPMN_ADONIS_Template.xml, angepasst auf zwei Pools. ADONIS-Import und Zuordnung der Taskdokumentation zum UI-Feld Documentation - Element documentation sind unbestaetigt.</documentation>
    <participant id="_a6500000-1000-4000-8000-000000000005" name="Kunde" processRef="process_a6500000-1000-4000-8000-000000000010"/>
    <participant id="_a6500000-1000-4000-8000-000000000006" name="Organisation" processRef="process_a6500000-1000-4000-8000-000000000020"/>
    <messageFlow id="_a6500000-1000-4000-8000-000000000007" name="Anmeldung mit Grundschulempfehlung und Nachweisen" sourceRef="_a6500000-1000-4000-8000-000000000014" targetRef="_a6500000-1000-4000-8000-000000000060" messageRef="_a6500000-1000-4000-8000-000000000002">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0"><adonis:value>true</adonis:value><adonis:metavalue/></adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0"><adonis:value>automatisch</adonis:value><adonis:metavalue/></adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
    <messageFlow id="_a6500000-1000-4000-8000-000000000008" name="Anmeldebestaetigung" sourceRef="_a6500000-1000-4000-8000-000000000069" targetRef="_a6500000-1000-4000-8000-000000000015" messageRef="_a6500000-1000-4000-8000-000000000003">
      <extensionElements>
        <adonis:connector>
          <adonis:attribute name="DISPLAY_DENOMNIATION" type="BOOL" notebook="1" sourcelang="" novalue="0"><adonis:value>true</adonis:value><adonis:metavalue/></adonis:attribute>
          <adonis:attribute name="REPRESENTATION_HAS_PROCESS" type="ENUM" notebook="1" sourcelang="" novalue="0" lang-independent="v0"><adonis:value>automatisch</adonis:value><adonis:metavalue/></adonis:attribute>
        </adonis:connector>
      </extensionElements>
    </messageFlow>
  </collaboration>
  <process id="process_a6500000-1000-4000-8000-000000000010" name="Kunde" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_a6500000-1000-4000-8000-000000000011">
      <lane id="_a6500000-1000-4000-8000-000000000011" name="Sorgeberechtigte">
        <flowNodeRef>_a6500000-1000-4000-8000-000000000012</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000013</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000014</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000015</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000016</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="_a6500000-1000-4000-8000-000000000012" name="Bedarf an Anmeldung an weiterfuehrender Schule festgestellt">
      <outgoing>_a6500000-1000-4000-8000-000000000031</outgoing>
    </startEvent>
    <task id="_a6500000-1000-4000-8000-000000000013" name="Anmeldeunterlagen zusammenstellen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Sorgeberechtigten fuellen das Anmeldeformular der weiterfuehrenden Schule aus und stellen die Grundschulempfehlung, die Geburtsurkunde und den Nachweis des Wohnsitzes zusammen. Ergebnis sind vollstaendige Anmeldeunterlagen.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000031</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000032</outgoing>
    </task>
    <sendTask id="_a6500000-1000-4000-8000-000000000014" name="Anmeldung einreichen" isForCompensation="false" messageRef="_a6500000-1000-4000-8000-000000000002">
      <documentation textFormat="text/plain">Die Sorgeberechtigten reichen die Anmeldung innerhalb des vorgesehenen Anmeldezeitraums bei der Schule ein. Nachricht von den Sorgeberechtigten an die Schule: Anmeldung mit Grundschulempfehlung und Nachweisen.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000032</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000033</outgoing>
    </sendTask>
    <receiveTask id="_a6500000-1000-4000-8000-000000000015" name="Anmeldebestaetigung entgegennehmen" isForCompensation="false" instantiate="false" messageRef="_a6500000-1000-4000-8000-000000000003">
      <documentation textFormat="text/plain">Die Sorgeberechtigten erhalten die Anmeldebestaetigung der Schule. Der Schulplatz fuer das Kind ist damit bestaetigt und das Kundenbeduerfnis erfuellt.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000033</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000034</outgoing>
    </receiveTask>
    <endEvent id="_a6500000-1000-4000-8000-000000000016" name="Anmeldebestaetigung erhalten">
      <incoming>_a6500000-1000-4000-8000-000000000034</incoming>
    </endEvent>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000031" sourceRef="_a6500000-1000-4000-8000-000000000012" targetRef="_a6500000-1000-4000-8000-000000000013"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000032" sourceRef="_a6500000-1000-4000-8000-000000000013" targetRef="_a6500000-1000-4000-8000-000000000014"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000033" sourceRef="_a6500000-1000-4000-8000-000000000014" targetRef="_a6500000-1000-4000-8000-000000000015"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000034" sourceRef="_a6500000-1000-4000-8000-000000000015" targetRef="_a6500000-1000-4000-8000-000000000016"/>
  </process>
  <process id="process_a6500000-1000-4000-8000-000000000020" name="Organisation" isExecutable="false" isClosed="false" processType="None">
    <laneSet id="laneSet_a6500000-1000-4000-8000-000000000021">
      <lane id="_a6500000-1000-4000-8000-000000000021" name="Schule">
        <flowNodeRef>_a6500000-1000-4000-8000-000000000060</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000061</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000062</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000063</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000064</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000068</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000069</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000070</flowNodeRef>
      </lane>
      <lane id="_a6500000-1000-4000-8000-000000000022" name="Schulverwaltungsamt">
        <flowNodeRef>_a6500000-1000-4000-8000-000000000065</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000066</flowNodeRef>
        <flowNodeRef>_a6500000-1000-4000-8000-000000000067</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="_a6500000-1000-4000-8000-000000000060" name="Anmeldung eingegangen">
      <outgoing>_a6500000-1000-4000-8000-000000000080</outgoing>
      <messageEventDefinition id="_a6500000-1000-4000-8000-000000000090" messageRef="_a6500000-1000-4000-8000-000000000002"/>
    </startEvent>
    <task id="_a6500000-1000-4000-8000-000000000061" name="Anmeldung entgegennehmen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schule nimmt die eingegangene Anmeldung mit den beigefuegten Unterlagen entgegen und nimmt sie in Bearbeitung. Ergebnis ist eine in Bearbeitung genommene Anmeldung.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000080</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000081</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000062" name="Anmeldeunterlagen auf Vollstaendigkeit pruefen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schule prueft, ob Anmeldeformular, Grundschulempfehlung, Geburtsurkunde und Wohnsitznachweis vollstaendig vorliegen. Im betrachteten Happy Path sind alle Unterlagen vollstaendig. Ergebnis sind geprueft vollstaendige Unterlagen.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000081</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000082</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000063" name="Schueler- und Anmeldedaten erfassen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schule erfasst die Schueler- und Anmeldedaten des Kindes aus den geprueften Unterlagen. Ergebnis ist ein vollstaendig erfasster Anmeldedatensatz.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000082</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000083</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000064" name="Anmeldedaten an Schulverwaltungsamt melden" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schule meldet die erfassten Anmeldedaten des Kindes an das Schulverwaltungsamt. Uebermittelt werden die Anmeldedaten des Kindes zur Pruefung der Platzzuordnung.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000083</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000084</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000065" name="Schulbezirkszuordnung und Schulplatzvergabe pruefen" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulverwaltungsamt nimmt die gemeldeten Anmeldedaten entgegen und prueft die Schulbezirkszuordnung sowie die Schulplatzvergabe. Im betrachteten Happy Path ist ein Schulplatz verfuegbar und die Zuordnung zulaessig.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000084</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000085</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000066" name="Anmeldung im Schulverwaltungssystem erfassen" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulverwaltungsamt erfasst die Anmeldung und die Platzzuordnung im Schulverwaltungssystem. Ergebnis ist eine nachvollziehbar dokumentierte Anmeldung.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000085</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000086</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000067" name="Platzzuordnung an Schule bestaetigen" isForCompensation="false">
      <documentation textFormat="text/plain">Das Schulverwaltungsamt bestaetigt der Schule die Platzzuordnung des Kindes. Ergebnis ist die Rueckmeldung zur Platzzuordnung als Grundlage der Aufnahme.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000086</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000087</outgoing>
    </task>
    <task id="_a6500000-1000-4000-8000-000000000068" name="Aufnahme bestaetigen und Anmeldebestaetigung erstellen" isForCompensation="false">
      <documentation textFormat="text/plain">Die Schule bestaetigt auf Grundlage der Platzzuordnung die Aufnahme des Kindes und erstellt die Anmeldebestaetigung. Ergebnis ist eine versandfertige Anmeldebestaetigung.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000087</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000088</outgoing>
    </task>
    <sendTask id="_a6500000-1000-4000-8000-000000000069" name="Anmeldebestaetigung versenden" isForCompensation="false" messageRef="_a6500000-1000-4000-8000-000000000003">
      <documentation textFormat="text/plain">Die Schule versendet die Anmeldebestaetigung an die Sorgeberechtigten. Nachricht von der Schule an die Sorgeberechtigten: Anmeldebestaetigung.</documentation>
      <incoming>_a6500000-1000-4000-8000-000000000088</incoming>
      <outgoing>_a6500000-1000-4000-8000-000000000089</outgoing>
    </sendTask>
    <endEvent id="_a6500000-1000-4000-8000-000000000070" name="Anmeldebestaetigung versandt">
      <incoming>_a6500000-1000-4000-8000-000000000089</incoming>
    </endEvent>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000080" sourceRef="_a6500000-1000-4000-8000-000000000060" targetRef="_a6500000-1000-4000-8000-000000000061"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000081" sourceRef="_a6500000-1000-4000-8000-000000000061" targetRef="_a6500000-1000-4000-8000-000000000062"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000082" sourceRef="_a6500000-1000-4000-8000-000000000062" targetRef="_a6500000-1000-4000-8000-000000000063"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000083" sourceRef="_a6500000-1000-4000-8000-000000000063" targetRef="_a6500000-1000-4000-8000-000000000064"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000084" sourceRef="_a6500000-1000-4000-8000-000000000064" targetRef="_a6500000-1000-4000-8000-000000000065"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000085" sourceRef="_a6500000-1000-4000-8000-000000000065" targetRef="_a6500000-1000-4000-8000-000000000066"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000086" sourceRef="_a6500000-1000-4000-8000-000000000066" targetRef="_a6500000-1000-4000-8000-000000000067"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000087" sourceRef="_a6500000-1000-4000-8000-000000000067" targetRef="_a6500000-1000-4000-8000-000000000068"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000088" sourceRef="_a6500000-1000-4000-8000-000000000068" targetRef="_a6500000-1000-4000-8000-000000000069"/>
    <sequenceFlow id="_a6500000-1000-4000-8000-000000000089" sourceRef="_a6500000-1000-4000-8000-000000000069" targetRef="_a6500000-1000-4000-8000-000000000070"/>
  </process>
